---
layout: layouts/base.njk
pagination:
  data: lineageVisible
  size: 1
  alias: entry
permalink: "/library/{{ entry.slug }}/"
eleventyComputed:
  title: "{{ entry.title }}"
  description: "{{ entry.title }}: part of Research Library, the lineage behind Practice Labs."
kicker: Research Library
kickerLink: /library/
---
{%- set cluster = lineage.clusters | clusterById(entry.cluster) -%}
{%- set kickerExtra = cluster.title -%}
{%- set header = entry.header or cluster.header or site.lineageHeader -%}
{%- set headerTone = "red" -%}
{%- set subtitle = entry.people + " · " + entry.field -%}
{% include "partials/page-header.njk" %}
<main id="main" class="reading">
  <article class="reading__inner entry">
    {#- Breadcrumb back to the Library, with three small icons on the far right: the Library Index, the Source Map and the Research Radar. -#}
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/library/browse/">Library</a></li>
        <li><a href="/library/browse/#{{ cluster.id }}">{{ cluster.short or cluster.title }}</a></li>
        <li aria-current="page">{{ entry.title }}</li>
      </ol>
      {#- Three small icons on the far right: this page in the Library Index (A to Z, at its letter),
          on the Source Map (a hub and its links), and on the Research Radar. -#}
      <a class="crumbs__icon crumbs__icon--first" href="/library/index/#pages-{{ entry.title | indexLetter }}" aria-label="See this page in the Library Index" title="See it in the Library Index">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3.5h11.5l4.5 4.5v12.5H4Z"/><path d="M15.5 3.5V8H20"/><path d="M7.5 11.5h9M7.5 14.5h9M7.5 17.5h6"/></svg>
      </a>
      <a class="crumbs__icon" href="/library/map/#{{ entry.slug }}" aria-label="See this page on the Source Map" title="See it on the Source Map">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12 5 5M12 12l7-7M12 12l-7 7M12 12l7 7M5 5h0"/><circle cx="12" cy="12" r="3.2"/><circle class="crumbs__icon-fill" cx="4.5" cy="4.5" r="2.2"/><circle class="crumbs__icon-fill" cx="19.5" cy="4.5" r="2.2"/><circle class="crumbs__icon-fill" cx="4.5" cy="19.5" r="2.2"/><circle class="crumbs__icon-fill" cx="19.5" cy="19.5" r="2.2"/></svg>
      </a>
      <a class="crumbs__icon" href="/library/radar/#{{ entry.slug }}" aria-label="See this page on the Research Radar" title="See it on the Research Radar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><path d="M12 2v20M2 12h20"/><circle class="crumbs__icon-fill" cx="16.5" cy="7.5" r="1.8"/></svg>
      </a>
    </nav>
    {%- if entry.status == "hidden" %}<p class="draft-banner">Hidden. This page only shows in your preview. Set its status to “Review” or “Published” to put it on the live site.</p>
    {%- elif entry.status != "published" and reviewMode %}<p class="draft-note">Draft · this page is still being reviewed and may change.</p>{% endif %}
    <p class="entry__tagline">{{ entry.tagline | safe }}</p>

    <section class="entry__section entry__who">
      <h2 class="label">Who they are</h2>
      {%- for p in entry.who %}<p>{{ p | safe }}</p>{% endfor %}
    </section>

    <section class="entry__section">
      <h2 class="label">Key concepts</h2>
      <ul class="concepts">
        {%- for c in entry.concepts %}<li class="concept"><h3>{{ c.term }}</h3><p>{{ c.def | safe }}</p></li>{% endfor %}
      </ul>
    </section>

    {#- Core framework (optional): a named, numbered set from this source, like the Five Losing Strategies. #}
    {%- if entry.framework and entry.framework.items.length %}
    <section class="entry__section framework">
      <h2 class="label">Core framework</h2>
      <h3 class="framework__name">{{ entry.framework.name }}</h3>
      {%- if entry.framework.intro %}<p class="framework__intro">{{ entry.framework.intro | safe }}</p>{% endif %}
      <ol class="framework__items">
        {%- for i in entry.framework.items %}<li><h4>{{ i.name }}</h4><p>{{ i.def | safe }}</p></li>{% endfor %}
      </ol>
    </section>
    {%- endif %}

    {#- Left column: Context, then Sources. Right column: In the Practice Labs.
        Side by side on wide screens, stacked on phones. #}
    <div class="entry__pair">
    <div class="entry__side">
    {#- Context: how this research connects to the work (entry.context), on the oxblood background. #}
    <section class="entry__context">
      <h2 class="label label--light">Context</h2>
      <p>{{ entry.context | safe }}</p>
    </section>

    <section class="entry__section entry__sources">
      <h2 class="label">Sources</h2>
      <ul class="sources">
        {%- for s in entry.sources %}
        <li>{{ s.cite | safe }}{% if s.url %} <a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.label or "Read the source" }} <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>{% endif %}</li>
        {%- endfor %}
      </ul>
    </section>
    </div>

    {#- In the Practice Labs: a practical exercise adapted from the research's own methods (entry.exercise). #}
    {%- if entry.exercise %}
    <section class="entry__section exercise">
      <h2 class="label">In the Practice Labs</h2>
      <h3 class="exercise__title">{{ entry.exercise.title | safe }}</h3>
      {%- if entry.exercise.time %}<p class="exercise__time">{{ entry.exercise.time }}</p>{% endif %}
      <ol class="exercise__steps">
        {%- for step in entry.exercise.steps %}<li>{{ step | safe }}</li>{% endfor %}
      </ol>
      {%- if entry.exercise.why %}<p class="exercise__why"><strong>Why this works:</strong> {{ entry.exercise.why | safe }}</p>{% endif %}
      <p class="exercise__care">This is a practice, not therapy. Go at your own pace, and stop if it stirs up more than you want to hold right now. If it does, bring it to someone you trust, your therapist or coach, or <a href="/contact/">a conversation with us</a>.</p>
    </section>
    {%- endif %}
    </div>


    {%- if entry.heartLine %}<p class="heart-line">{{ entry.heartLine | safe }}</p>{% endif %}

    {#- Related pages, under the heart-line. #}
    {%- set relatedShown = [] -%}
      {%- for slug in entry.related %}{% set r = lineageVisible | entryBySlug(slug) %}{% if r %}{% set relatedShown = (relatedShown.push(r), relatedShown) %}{% endif %}{% endfor %}
      {%- if relatedShown.length %}
      <p class="related">Related: {% for r in relatedShown %}<a href="/library/{{ r.slug }}/">{{ r.title }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
      {%- endif %}

    <nav class="entry__pager" aria-label="Research Library pages">
      <a href="/library/browse/">← Browse the Library</a>
      {%- set nextEntry = lineageVisible[pagination.pageNumber + 1] %}
      {%- if nextEntry %}<a href="/library/{{ nextEntry.slug }}/">Next: {{ nextEntry.title }} →</a>{% endif %}
    </nav>
  </article>
</main>
