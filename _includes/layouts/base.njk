<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != site.name %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  {#- private: true keeps a page out of search engines. It's still reachable by anyone with the link. #}
  {%- if private %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  <meta property="og:title" content="{{ ogTitle or title or site.name }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  {%- if ogImage %}
  <meta property="og:image" content="{{ ogImage | absoluteUrl }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- endif %}
  <link rel="icon" href="/assets/img/rtl-logo-oxblood.svg" type="image/svg+xml">
  {#- Fonts are served from this site (assets/fonts), so they look the same everywhere. #}
  <link rel="preload" href="/assets/fonts/dm-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/fraunces-latin-wght-italic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {{ content | safe }}
  {% include "partials/footer.njk" %}
  <script src="/assets/js/menu.js" defer></script>
  {%- for script in scripts %}
  <script src="/assets/js/{{ script }}" defer></script>
  {%- endfor %}
</body>
</html>
