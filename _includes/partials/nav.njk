{#- Menu items. The Library submenu is built here, not in _data/site.js. -#}
{%- macro navItems(site, lineage, lineageVisible, page, reviewMode) -%}
{%- for item in site.nav -%}
{%- if reviewMode or not item.draft -%}
  {%- set children = item.children -%}
  {%- set href = item.href if (reviewMode or not item.liveHref) else item.liveHref %}
  {%- if item.fromLineage %}
  {#- The Library menu: about the Library, browsing it, the Library Index, the Source Map and the Research Radar. -#}
  <li class="has-sub">
    <a href="{{ href }}"{% if page.url.startsWith(item.href) %} aria-current="page"{% endif %}>{{ item.label }}</a>
    <ul class="sub">
      <li><a href="/library/">About the Library</a></li>
      <li><a href="/library/browse/">Browse the Library</a></li>
      <li><a href="/library/index/">Library Index</a></li>
      <li><a href="/library/map/">Source Map</a></li>
      <li><a href="/library/radar/">Research Radar</a></li>
    </ul>
  </li>
  {%- else %}
  <li class="{{ 'has-sub' if children }}">
    <a href="{{ href }}"{% if page.url.startsWith(item.href) and item.href != '#' %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- if children %}
    <ul class="sub">
      {%- for child in children %}{% if reviewMode or not child.draft %}<li{% if child.nested %} class="sub__nested"{% endif %}><a href="{{ child.href }}">{{ child.label }}</a></li>{% endif %}{% endfor %}
    </ul>
    {%- endif %}
  </li>
  {%- endif %}
{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
