{#- Every post in blog/posts/, newest first (the blog index). -#}
<ul class="post-list">
  {%- for post in collections.post | reverse %}
  <li>
    <p class="label">{{ post.data.kind or "Essay" }} · {{ post.date | longDate }}</p>
    <h2><a href="{{ post.url }}">{{ post.data.title | safe }}</a></h2>
    <p class="soft">{{ post.data.dek }}</p>
    <a class="post-list__more" href="{{ post.url }}">{{ (b.moreText if b and b.moreText) or "Read the essay →" }}</a>
  </li>
  {%- endfor %}
</ul>
