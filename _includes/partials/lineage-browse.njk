{#- The Research Library browse rows (filter chips, search, one row per cluster), drawn by
    assets/js/lineage-browse.js. The search hint and "nothing found" text come from the page's words file (browseBlock).
    The map is its own section now (partials/lineage-map.njk), on the Source Map page. -#}
    {#- Browse: filter chips and search (assets/js/lineage-browse.js), then one side-scrolling row per cluster. -#}
    <section class="browse" aria-label="Browse the Research Library">
      <div class="browse__bar">
        <div class="browse__chips" role="group" aria-label="Show one cluster">
          <button type="button" class="chip is-on" data-filter="all" aria-pressed="true">All</button>
          {%- for cluster in lineage.clusters | clustersWithEntries(lineageVisible) %}
          <button type="button" class="chip" data-filter="{{ cluster.id }}" aria-pressed="false">{{ cluster.short or cluster.title }}</button>
          {%- endfor %}
        </div>
        {%- from "partials/library-icons.njk" import libraryIcon %}
        <div class="map-search-row">
        <label class="browse__search map-search">
          <span class="visually-hidden">Search the Research Library</span>
          <input type="search" id="browse-search" placeholder="{{ browseBlock.searchPlaceholder }}" autocomplete="off">
        </label>
        {{ libraryIcon("index", "/library/a-z/", "Library Index", true) }}
        {{ libraryIcon("map", "/library/map/", "Source Map") }}
        {{ libraryIcon("radar", "/library/radar/", "Research Radar") }}
        </div>
        <p class="browse__count" id="browse-count" aria-live="polite"></p>
      </div>

      {%- for cluster in lineage.clusters | clustersWithEntries(lineageVisible) %}
      <section class="cluster" id="{{ cluster.id }}" data-cluster="{{ cluster.id }}" aria-labelledby="{{ cluster.id }}-title">
        <div class="cluster__head">
          <div>
            <h2 id="{{ cluster.id }}-title" class="cluster__title">{{ cluster.title }}</h2>
            <p class="cluster__blurb">{{ cluster.blurb }}</p>
          </div>
          <div class="row-nav" aria-hidden="true">
            <button type="button" class="row-nav__btn" data-dir="-1" tabindex="-1">‹</button>
            <button type="button" class="row-nav__btn" data-dir="1" tabindex="-1">›</button>
          </div>
        </div>
        <ul class="entry-cards entry-cards--row">
          {%- for entry in lineageVisible | inCluster(cluster.id) %}
          <li class="entry-card{% if entry.status == 'hidden' %} is-draft{% endif %}"
              data-search="{{ entry | searchText(cluster.title) }}">
            <a href="/library/{{ entry.slug }}/">
              {%- if entry.status == "hidden" %}<span class="draft-badge">Hidden · preview only</span>
              {%- elif entry.status != "published" and reviewMode %}<span class="draft-badge draft-badge--quiet">Draft</span>{% endif %}
              <h3>{{ entry.title }}</h3>
              <p class="entry-card__people">{{ entry.people | safe }}</p>
              <p class="entry-card__tagline">{{ entry.tagline | safe }}</p>
            </a>
          </li>
          {%- endfor %}
        </ul>
      </section>
      {%- endfor %}
      <p class="browse__empty" id="browse-empty" hidden>{{ browseBlock.emptyText or "Nothing matches that yet. Try another word, or" }} <button type="button" class="link-button" id="browse-clear">clear the search</button>.</p>
    </section>
    <script src="/assets/js/lineage-browse.js" defer></script>
