{#- Closes the blog index and every post: the mailing-list sign-up and a link to book a consult.
    The words are in _data/pages/shared.yml (blogCta), editable in /admin under Pages → Shared blocks. -#}
{%- from "partials/signup.njk" import signup -%}
{%- set c = pages.shared.blogCta -%}
<section class="band">
  <div class="band__inner">
    <p class="label">{{ c.label }}</p>
    <h2>{{ c.heading | md | safe }}</h2>
    <hr class="rule">
    <p class="soft">{{ c.text | md | safe }}</p>
    {{ signup(source="Blog", button=c.button, fine=c.fine, id="blog-signup") }}
    <p class="soft">{{ c.after | md | safe }}</p>
  </div>
</section>
