{#- Inner-page header: the roots photo toned to oxblood, faint threads in the menu bar, then the page title.
    Set `kicker`, `title` and optional `subtitle` / `kickerLink` in the page.
    The photo comes from `header` (image, position, zoom, and color: true to keep the photo's own colors) if the page sets one, otherwise site.defaultHeader (lineage pages use site.lineageHeader).
    Research Roots pages set headerTone = "red" for the deep oxblood look; other pages keep more of the photo's color. -#}
{%- set h = header or site.defaultHeader -%}
<div class="page-head{% if h.color %} page-head--color{% elif headerTone == 'red' or h.tone == 'red' %} page-head--red{% endif %}">
  {#- The photo sits in its own clipped box so a zoomed photo stays inside the header, while the menu's dropdowns can hang below it. #}
  <div class="page-head__media" aria-hidden="true"><img class="page-head__photo" src="{{ h.image | media }}" alt="" aria-hidden="true" style="object-position: {{ h.position or 'center' }}; transform: scale({{ h.zoom or 1 }}); transform-origin: {{ h.position or 'center' }}"></div>
  <div class="page-head__tint" aria-hidden="true"></div>
  <div class="page-head__veil" aria-hidden="true"></div>
  {% menuThreads %}
  {% include "partials/header.njk" %}
  <div class="page-head__title">
    {%- if kicker %}<p class="kicker">{% if kickerLink %}<a href="{{ kickerLink }}">{{ kicker | safe }}</a>{% else %}{{ kicker | safe }}{% endif %}{% if kickerExtra %} · {{ kickerExtra | safe }}{% endif %}</p>{% endif %}
    <h1>{{ (heading or title) | safe }}</h1>
    {%- if subtitle %}<p class="page-head__subtitle">{{ subtitle | safe }}</p>{% endif %}
  </div>
</div>
