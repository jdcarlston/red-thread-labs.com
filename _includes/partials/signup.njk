{#- Mailing-list sign-up form.

    {% from "partials/signup.njk" import signup %}
    {{ signup(source="Home page", button="Join the list", names=true) }}

    source  - shows up in Kit (and the Netlify form) so you can see where people signed up
    button  - the button text
    names   - ask for first and last name as well as email
    fine    - the small print under the form

    Each sign-up is saved twice: to the Netlify form "mailing-list" (your own copy) and to Kit
    through /api/subscribe. The page needs scripts: ["signup.js"] in its front matter. -#}
{%- macro signup(source, button="Join the list", names=false, fine="Unsubscribe anytime with one click. We never share your email.", id="signup") -%}
<form class="signup" name="mailing-list" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-signup novalidate>
  <input type="hidden" name="form-name" value="mailing-list">
  <input type="hidden" name="source" value="{{ source }}">
  <p class="signup__hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
  {%- if names %}
  <div class="signup__row">
    <label class="sr-only" for="{{ id }}-first">First name</label>
    <input id="{{ id }}-first" name="first_name" type="text" placeholder="First name" autocomplete="given-name" required>
    <label class="sr-only" for="{{ id }}-last">Last name</label>
    <input id="{{ id }}-last" name="last_name" type="text" placeholder="Last name" autocomplete="family-name">
  </div>
  {%- endif %}
  <div class="signup__row">
    <label class="sr-only" for="{{ id }}-email">Email</label>
    <input id="{{ id }}-email" name="email" type="email" placeholder="Your email" autocomplete="email" required>
    <button class="btn btn--primary" type="submit">{{ button }}</button>
  </div>
  {%- if fine %}<p class="signup__fine">{{ fine }}</p>{% endif %}
  <p class="signup__msg" role="status" aria-live="polite"></p>
</form>
{%- endmacro %}
