{#- Draws a page's sections from its words file in _data/pages/ (edited in /admin under Pages).

    A page is a list of rows. Each row is a full-width background band with blocks inside:
      style: band | band-alt (lighter) | band-center | reading | reading-dark | photo (needs image)
      main: true on the row that holds the page's main content (the skip link jumps there)
      id, label (for screen readers), inner (an extra class on the inner box)

    Each block has a type (text if left out) and the fields that type uses. Every text field is
    Markdown: *italic*, **bold**, [link](https://...). Links can also be @booking (the Calendly link)
    or @email (the contact address). Links into Practice Labs (a draft page) go to /contact/ on the live site
    until that page is published. Block types:
      text       label, statement, heading, lede, paragraphs (softer text), plain (regular text), prose, buttons
      checklist  ...text fields, listLabel, items, ordered
      steps      items { num, title, text }
      cards      items { id, label, title, text, button, link }
      facts      items { label, value, note }
      values     items { name, text }
      offers     items { title, text, linkText, link }
      faq        items { q, a }
      about      image, alt, paragraphs (a photo beside text)
      photos     images { image, alt }
      signup     signupSource, button, names, fine, formId
      heart      lines, anchor (the closing heart-lines)
      bigdate    label, big, place, buttons, note (the big date on a photo band)
      include    name: about-jd | booking | posts | contact | lineage-browse
    A row can instead be include: blog-cta (the mail-list sign-up band that closes the blog).
    Any block can also have: id, center (centers it), bare (no section box around it), after (paragraphs after a list).
    Buttons: { text, link, style: primary | ghost }. -#}
{%- from "partials/signup.njk" import signup -%}
{%- from "partials/booking.njk" import bookingOptions with context -%}

{%- macro href(link) -%}
{%- if link == "@booking" -%}{{ site.bookingUrl }}{%- elif link.startsWith("/practice-labs") and not reviewMode -%}/contact/{%- elif link.startsWith("@email") -%}mailto:{{ site.email }}{{ link.slice(6) }}{%- else -%}{{ link }}{%- endif -%}
{%- endmacro -%}
{%- macro ext(link) -%}{%- set u = href(link) -%}{%- if u.startsWith("http") %} target="_blank" rel="noopener"{% endif -%}{%- endmacro -%}

{%- macro buttons(list) -%}
{%- if list and list.length %}
<div class="btn-row">{% for b in list %}<a class="btn btn--{{ b.style or 'primary' }}" href="{{ href(b.link) }}"{{ ext(b.link) }}>{{ b.text }}</a>{% endfor %}</div>
{%- endif -%}
{%- endmacro -%}

{%- macro paras(list, cls) -%}
{%- for p in list or [] %}
<p{% if cls %} class="{{ cls }}"{% endif %}>{{ p | md | safe }}</p>
{%- endfor -%}
{%- endmacro -%}

{%- macro blockBody(b) -%}
{%- if b.label %}
<p class="label">{{ b.label | md | safe }}</p>
{%- endif %}
{%- if b.statement %}
<p class="statement">{{ b.statement | md | safe }}</p>
{%- endif %}
{%- if b.heading %}
<h2>{{ b.heading | md | safe }}</h2>
{%- endif %}
{%- if (b.heading and b.rule != false) or b.rule %}
<hr class="rule">
{%- endif %}
{%- if b.lede %}
<p class="lede">{{ b.lede | md | safe }}</p>
{%- endif %}
{{ paras(b.paragraphs, "soft") }}
{{ paras(b.plain) }}
{%- if b.prose and b.prose.length %}
<div class="prose">{{ paras(b.prose) }}</div>
{%- endif %}

{%- if b.type == "checklist" %}
{%- if b.listLabel %}
<p class="label">{{ b.listLabel | md | safe }}</p>
{%- endif %}
{%- set tag = "ol" if b.ordered else "ul" %}
<{{ tag }} class="checklist">{% for i in b.items %}
  <li>{{ i | md | safe }}</li>{% endfor %}
</{{ tag }}>

{%- elif b.type == "steps" %}
<ol class="steps">{% for i in b.items %}
  <li><span class="steps__num">{{ i.num or loop.index }}</span>{% if i.title %}<h3>{{ i.title | md | safe }}</h3>{% endif %}<p>{{ i.text | md | safe }}</p></li>{% endfor %}
</ol>

{%- elif b.type == "cards" %}
<ul class="cards">{% for c in b.items %}
  <li class="card"{% if c.id %} id="{{ c.id }}"{% endif %}>
    {% if c.label %}<p class="label">{{ c.label | md | safe }}</p>{% endif %}
    <h3>{{ c.title | md | safe }}</h3>
    <p>{{ c.text | md | safe }}</p>
    {% if c.link %}<div class="card__actions"><a class="btn btn--ghost" href="{{ href(c.link) }}"{{ ext(c.link) }}>{{ c.button }}</a></div>{% endif %}
  </li>{% endfor %}
</ul>

{%- elif b.type == "facts" %}
<ul class="facts">{% for f in b.items %}
  <li><span class="label">{{ f.label }}</span><strong>{{ f.value | md | safe }}</strong><span>{{ f.note | md | safe }}</span></li>{% endfor %}
</ul>

{%- elif b.type == "values" %}
<ul class="values-list">{% for v in b.items %}
  <li><strong>{{ v.name }}</strong><span>{{ v.text | md | safe }}</span></li>{% endfor %}
</ul>

{%- elif b.type == "offers" %}
<ul class="offer-list">{% for o in b.items %}
  <li><h3>{{ o.title | md | safe }}</h3><p>{{ o.text | md | safe }}</p>{% if o.link %}<a href="{{ href(o.link) }}"{{ ext(o.link) }}>{{ o.linkText }}</a>{% endif %}</li>{% endfor %}
</ul>

{%- elif b.type == "faq" %}
<div class="faq">{% for f in b.items %}
  <details><summary>{{ f.q | md | safe }}</summary><p>{{ f.a | md | safe }}</p></details>{% endfor %}
</div>

{%- elif b.type == "about" %}
<div class="about">
  <img src="{{ b.image | media }}" alt="{{ b.alt }}" loading="lazy">
  <div class="prose">{{ paras(b.text) }}</div>
</div>

{%- elif b.type == "photos" %}
<div class="photo-row">{% for i in b.images %}
  <img src="{{ i.image | media }}" alt="{{ i.alt }}" loading="lazy">{% endfor %}
</div>

{%- elif b.type == "signup" %}
{{ signup(source=b.signupSource, button=b.button or "Join the list", names=b.names, fine=b.fine or "Unsubscribe anytime with one click. We never share your email.", id=b.formId or "signup") }}

{%- elif b.type == "heart" %}
{% for l in b.lines %}<p>{{ l | md | safe }}</p>
{% endfor %}{% if b.anchor %}<p class="anchor">{{ b.anchor | md | safe }}</p>{% endif %}

{%- elif b.type == "bigdate" %}
<p class="big-word">{{ b.big }}</p>
{%- if b.place %}
<p class="label">{{ b.place }}</p>
{%- endif %}
{%- endif %}

{{ paras(b.after, "soft") }}
{{ buttons(b.buttons) }}
{%- if b.note %}
<p class="soft">{{ b.note | md | safe }}</p>
{%- endif %}
{%- endmacro -%}

{%- macro block(b) -%}
{%- if b.type == "include" -%}
  {%- if b.name == "about-jd" %}{% include "partials/about-jd.njk" %}
  {%- elif b.name == "booking" %}{{ bookingOptions(source=b.signupSource, consultWas=b.consultWas, price=b.price, priceWas=b.priceWas, rate=b.rate) }}
  {%- elif b.name == "posts" %}{% include "partials/post-list.njk" %}
  {%- elif b.name == "contact" %}{% set contactBlock = b %}{% include "partials/contact-form.njk" %}
  {%- elif b.name == "lineage-browse" %}{% set browseBlock = b %}{% include "partials/lineage-browse.njk" %}
  {%- endif -%}
{%- elif b.bare -%}
{{ blockBody(b) }}
{%- else -%}
<section class="section{% if b.center %} section--center{% endif %}"{% if b.id %} id="{{ b.id }}"{% endif %}>
{{ blockBody(b) }}
</section>
{%- endif -%}
{%- endmacro -%}

{%- set rowClass = { "band": "band", "band-alt": "band band--alt", "band-center": "band band--center", "reading": "reading", "reading-dark": "reading reading--dark", "photo": "cta-photo" } -%}
{%- for row in rows %}
{%- if row.include == "blog-cta" %}
{% include "partials/blog-cta.njk" %}
{%- else %}
{%- set tag = "main" if row.main else "section" %}
{%- set isReading = row.style == "reading" or row.style == "reading-dark" %}
<{{ tag }}{% if row.main %} id="main"{% elif row.id %} id="{{ row.id }}"{% endif %} class="{{ rowClass[row.style or 'band'] }}"{% if row.label %} aria-label="{{ row.label }}"{% endif %}>
  {%- if row.style == "photo" and row.image %}
  <img src="{{ row.image | media }}" alt="" aria-hidden="true" loading="lazy">
  {%- endif %}
  <div class="{{ 'reading__inner' if isReading else 'band__inner' }}{% if row.inner %} {{ row.inner }}{% endif %}">
    {%- for b in row.blocks %}
    {{ block(b) }}
    {%- endfor %}
  </div>
</{{ tag }}>
{%- endif %}
{%- endfor %}
