{#- The Source Map: Lab Sources at the center, one bubble per cluster, drawn by assets/js/lineage-map.js.
    Used on the Source Map page (/library/map/). The heading and hint come from the page's words file (mapBlock). -#}
    <section class="lineage-map" aria-labelledby="lineage-map-title">
      <h2 id="lineage-map-title" class="cluster__title">{{ mapBlock.mapTitle or "How it all connects" }}</h2>
      <p class="cluster__blurb">{{ mapBlock.mapBlurb | md | safe }}</p>
      {#- Search: finds pages with the same words as the Library search; picking one opens its cluster on the map. -#}
      <div class="map-search">
        <label class="browse__search">
          <span class="visually-hidden">Search the map</span>
          <input type="search" id="map-search" placeholder="{{ mapBlock.searchPlaceholder or 'Search names and ideas' }}" autocomplete="off" aria-controls="map-search-results">
        </label>
        <ul class="map-search__results" id="map-search-results" hidden></ul>
      </div>
      <div class="lineage-map__frame">
        <div class="lineage-map__stage">
          <button type="button" class="lineage-map__back" id="lineage-map-back" hidden>← All clusters</button>
          <svg id="lineage-map" class="lineage-map__svg" role="group" aria-label="Map of the Research Library"></svg>
        </div>
        <aside id="lineage-map-panel" class="lineage-map__panel" aria-live="polite"></aside>
      </div>
      <script type="application/json" id="lineage-map-data">{{ lineageVisible | lineageMapData(lineage.clusters) | safe }}</script>
      <script src="/assets/js/lineage-map.js" defer></script>
    </section>
