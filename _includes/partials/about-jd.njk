{#- The short "About JD" block used on event and offer pages. The full story is on /about/jd/.
    The words are in _data/pages/shared.yml (aboutJd), editable in /admin under Pages → Shared blocks.
    Set aboutHeading before including it to change the heading for one page. -#}
{%- set a = pages.shared.aboutJd -%}
<section class="section">
  <h2>{{ (aboutHeading or (a.heading | md)) | safe }}</h2>
  <hr class="rule">
  <div class="about">
    <img src="{{ a.image | media }}" alt="{{ a.alt }}" loading="lazy">
    <div class="prose">
      {%- for p in a.paragraphs %}
      <p>{{ p | md | safe }}</p>
      {%- endfor %}
      <p class="about__links">{% for l in a.links %}<a href="{{ l.link }}">{{ l.text }}</a> {% endfor %}</p>
    </div>
  </div>
</section>
