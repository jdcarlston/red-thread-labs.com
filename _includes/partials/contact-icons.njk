{#- The ways to reach Red Thread Labs, as icons. Any link left empty in _data/site.js is skipped.
    Use: {% set iconsClass = "hero__icons" %}{% include "partials/contact-icons.njk" %} -#}
{%- set phoneHref = "tel:" + (site.phone | replace(" ", "")) if site.phone else "" -%}
{%- set links = [
  { href: phoneHref, label: "Call Red Thread Labs" + (" at " + site.phone if site.phone else ""), icon: '<path d="M6.6 3.5h2.6l1.4 4-2 1.4a12 12 0 0 0 6.5 6.5l1.4-2 4 1.4v2.6a2 2 0 0 1-2.1 2A17 17 0 0 1 4.6 5.6a2 2 0 0 1 2-2.1z"/>' },
  { href: site.bookingUrl, label: "Book a consultation on Calendly", icon: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>' },
  { href: site.contactUrl, label: "Send a message", icon: '<path d="M3 6h18v12H3zM3 6l9 7 9-7"/>' },
  { href: site.linkedin or site.linkedinPersonal, label: "LinkedIn", icon: '<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.7 1-2.6 2.3-2.6s2.2.9 2.2 2.6v3"/>' },
  { href: site.instagram, label: "Instagram", icon: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6"/>' },
  { href: site.facebook, label: "Facebook", icon: '<path d="M14 8h2.5V4.5H14A3.5 3.5 0 0 0 10.5 8v2.5H8V14h2.5v6.5H14V14h2.5l.5-3.5h-3V8.6c0-.4.2-.6.5-.6z"/>' }
] -%}
<ul class="contact-icons {{ iconsClass }}" aria-label="Get in touch">
  {%- for l in links %}{% if l.href %}
  <li><a href="{{ l.href }}" aria-label="{{ l.label }}"{% if l.href.startsWith("http") %} target="_blank" rel="noopener"{% endif %}><svg viewBox="0 0 24 24" aria-hidden="true">{{ l.icon | safe }}</svg></a></li>
  {%- endif %}{% endfor %}
</ul>
