{%- from "partials/nav.njk" import navItems -%}
{%- set hamburger -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>{%- endset -%}
<header class="site-header site-header--{{ headerStyle or 'inner' }}">
  {%- if headerStyle == "home" %}
  <div class="brand">
    <button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false">{{ hamburger | safe }}<span class="sr-only">Menu</span></button>
    <a class="brand__name" href="/">{{ site.name }}</a>
  </div>
  {%- else %}
  <a class="brand" href="/">{% logo "oxblood", 40 %}<span class="brand__name">{{ site.name }}</span></a>
  {%- endif %}
  <nav class="main-nav" aria-label="Main"><ul class="menu">{{ navItems(site, lineage, lineageVisible, page, reviewMode) }}</ul></nav>
  <a class="btn btn--book" href="{{ site.bookingUrl }}">Book a consultation</a>
  {%- if headerStyle != "home" %}
  <button class="menu-toggle menu-toggle--phone" type="button" aria-controls="site-menu" aria-expanded="false">{{ hamburger | safe }}<span class="sr-only">Menu</span></button>
  {%- endif %}
</header>
<div id="site-menu" class="menu-panel" hidden>
  <button class="menu-close" type="button" aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
  <nav aria-label="Site menu"><ul>{{ navItems(site, lineage, lineageVisible, page, reviewMode) }}</ul></nav>
  <a class="btn btn--book" href="{{ site.bookingUrl }}">Book a consultation</a>
</div>
