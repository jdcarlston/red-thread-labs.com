---
layout: layouts/base.njk
title: JD Carlston
kicker: About
heading: JD Carlston
eleventyComputed:
  subtitle: "{{ jd.subtitle }}"
description: JD Carlston is a Human Engineer, engineering leader, facilitator and coach, and the founder of Red Thread Labs.
header: { image: "img/jd-lighting-candles.jpg", position: "50% 35%", zoom: 1 }
permalink: /about/jd/
---
{#- JD's own About page. The words and photos come from _data/jd.yml, editable in /admin under Pages → JD's page.
    The `md` filter turns Markdown (links, *italic*, **bold**) into HTML. -#}
{% include "partials/page-header.njk" %}
{%- macro linkTo(url, text, cls) -%}
<a{% if cls %} class="{{ cls }}"{% endif %} href="{{ url }}"{% if url.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>{{ text }}</a>
{%- endmacro %}
<main id="main" class="reading">
  <div class="reading__inner">
    <section class="section">
      <div class="about">
        <img src="{{ jd.photo | media }}" alt="{{ jd.photoAlt }}">
        <div class="prose">
          <p class="lede">{{ jd.lede | md | safe }}</p>
          {% for p in jd.story %}<p>{{ p | md | safe }}</p>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="section">
      <p class="label">{{ jd.practices.label }}</p>
      <h2>{{ jd.practices.heading }}</h2>
      <hr class="rule">
      <ul class="cards cards--two">
        {% for c in jd.practices.cards %}
        <li class="card">
          <p class="label">{{ c.label }}</p>
          <h3>{{ c.heading }}</h3>
          <p>{{ c.text | md | safe }}</p>
          {% if c.link %}<div class="card__actions">{{ linkTo(c.link, c.button, "btn btn--ghost") }}</div>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>

    <section class="section">
      <p class="label">{{ jd.method.label }}</p>
      <h2>{{ jd.method.heading }}</h2>
      <hr class="rule">
      <div class="prose prose--wide">
        {% for p in jd.method.text %}<p>{{ p | md | safe }}</p>
        {% endfor %}
      </div>
    </section>

    <section class="section">
      <p class="label">{{ jd.artist.label }}</p>
      <h2>{{ jd.artist.heading }}</h2>
      <hr class="rule">
      <div class="prose prose--wide">
        {% for p in jd.artist.text %}<p>{{ p | md | safe }}</p>
        {% endfor %}
        <p class="about__links">{% for l in jd.artist.links %}{{ linkTo(l.link, l.text) }} {% endfor %}</p>
      </div>
    </section>

    <section class="section">
      <p class="label">{{ jd.partner.label }}</p>
      <div class="about">
        <img src="{{ jd.partner.photo | media }}" alt="{{ jd.partner.photoAlt }}" loading="lazy">
        <div class="prose">
          <p>{{ jd.partner.text | md | safe }}</p>
        </div>
      </div>
    </section>
  </div>
</main>

<section class="band band--center">
  <div class="band__inner">
    <h2>{{ jd.closing.heading }}</h2>
    <p class="soft">{{ jd.closing.text | md | safe }}</p>
    <div class="btn-row"><a class="btn btn--primary" href="{{ site.bookingUrl }}" target="_blank" rel="noopener">Book a free consultation</a><a class="btn btn--ghost" href="/contact/">Send a message</a></div>
  </div>
</section>
